# AgentCore Memory resource in the same AWS region as this application.
AWS_REGION=eu-north-1
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_NAMESPACE_TEMPLATE=traveler/__ACTOR_ID__/profile
AWS_PROFILE=default

# Local conversation/onboarding use Anthropic; research uses Claude Agent SDK.
AGENT_MODEL_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_RESEARCH_BACKEND=claude-agent-sdk
AGENT_RESEARCH_MODEL=claude-sonnet-4-6
AGENT_RESEARCH_MAX_TURNS=8
AGENT_RESEARCH_TIMEOUT_SECONDS=120
AGENT_RESEARCH_MAX_BUDGET_USD=0.5
AGENT_RESEARCH_MAX_SEARCHES=3
AGENT_RESEARCH_MAX_FETCHES=6
# Local startup pulls this from the shared secret into ignored .env.
ANTHROPIC_API_KEY=
# Production: explicit secret ARN wins over the local key; never falls back on errors.
ANTHROPIC_API_KEY_SECRET_ARN=
