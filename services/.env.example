AWS_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/USER_POOL_ID
COGNITO_JWKS_URL=https://cognito-idp.eu-central-1.amazonaws.com/USER_POOL_ID/.well-known/jwks.json
# Use a public client with USER_PASSWORD_AUTH, optional software-token MFA,
# refresh rotation (Essentials), and device remembering disabled.
# Cognito password auth does not issue arbitrary custom OAuth scopes by default.
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SESSION_DB_PATH=.runtime/auth.sqlite3
# Generate locally with the uv command in docs/runbooks/account-access.md.
SESSION_ENCRYPTION_KEY=
