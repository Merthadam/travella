# Copy this file to .env and fill in local development secrets.
# The real .env is ignored by Git and must never be committed.

# Tavily web research key used only by travella-research-mcp.
TAVILY_API_KEY=

# Optional server-restricted Google key used only by travella-map-mcp.
# Keep this separate from frontend/.env.local's VITE_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# Long-term memory is intentionally disabled in the first Phase 3B slice.
AGENT_MEMORY_PROVIDER=none
