# Copy this file to .env and fill in local development secrets.
# The real .env is ignored by Git and must never be committed.

# Tavily web research key used only by travella-research-mcp.
TAVILY_API_KEY=

# Optional server-restricted Google key used only by travella-map-mcp.
# Keep this separate from frontend/.env.local's VITE_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# Private Gateway-to-target authentication. Generate high-entropy values for
# deployment; neither value is sent to the browser.
MCP_ASSERTION_SIGNING_SECRET=
MCP_GATEWAY_SERVICE_TOKEN=
MCP_ASSERTION_AUDIENCE=travella-mcp
MCP_EVIDENCE_REGISTRY_PATH=.cache/travella-evidence.json

# AgentCore Memory is provisioned in eu-north-1 but application reads remain
# disabled until the LangGraph runtime is wired and authorization is enforced.
AWS_REGION=eu-north-1
AGENT_MEMORY_PROVIDER=agentcore
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_ARN=
AGENTCORE_MEMORY_NAMESPACE_TEMPLATE=traveler/{actorId}
