FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app
ENV UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev

# The locked SDK wheel bundles a native CLI for the target architecture.
RUN .venv/lib/python3.12/site-packages/claude_agent_sdk/_bundled/claude --version

COPY services ./services

# Research workers get disposable directories under /tmp; application code stays read-only.
RUN useradd --create-home --uid 10001 travella
USER travella
ENV HOME=/home/travella

EXPOSE 8080
CMD ["/app/.venv/bin/uvicorn", "services.agent.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
