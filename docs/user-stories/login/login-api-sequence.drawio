        <mxCell id="32" value="" style="fillOpacity=0;strokeOpacity=0;opacity=0;" vertex="1" parent="1"><mxGeometry x="1259" y="744" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="33" value="" style="fillOpacity=0;strokeOpacity=0;opacity=0;" vertex="1" parent="1"><mxGeometry x="1259" y="824" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="34" value="" style="fillOpacity=0;strokeOpacity=0;opacity=0;" vertex="1" parent="1"><mxGeometry x="934" y="824" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="35" value="" style="fillOpacity=0;strokeOpacity=0;opacity=0;" vertex="1" parent="1"><mxGeometry x="934" y="904" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="36" value="" style="fillOpacity=0;strokeOpacity=0;opacity=0;" vertex="1" parent="1"><mxGeometry x="164" y="904" width="2" height="2" as="geometry"/></mxCell>
        <mxCell id="10" value="1. Register or sign in (HTTPS/TLS)&lt;br&gt;Credentials go only to Amazon Cognito" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1" source="21" target="22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="11" value="2. Require email verification; offer optional authenticator-MFA setup" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=top;" edge="1" parent="1" source="23" target="24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="12" value="3. Submit verification or MFA code (when configured; HTTPS/TLS)" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1" source="25" target="26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="13" value="4. Short-lived access token&lt;br&gt;Silently refresh for up to 30 days; never in URLs or logs" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=top;" edge="1" parent="1" source="27" target="28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="14" value="5. GET /v1/plans (HTTPS/TLS)&lt;br&gt;Authorization: Bearer &amp;lt;access token&amp;gt;" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1" source="29" target="30"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="6. Validate signature, issuer, audience, expiry, and traveler subject&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Amazon Cognito keys are cached&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="995" y="610" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="16" value="7. Read plans where owner = token subject" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1" source="31" target="32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="8. Matching plans" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=top;" edge="1" parent="1" source="33" target="34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="18" value="9. 200 OK: only this traveler’s plans&lt;br&gt;or 401 for an invalid/expired token" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=11;align=center;verticalAlign=top;" edge="1" parent="1" source="35" target="36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="&lt;b&gt;Security rules&lt;/b&gt;&lt;br&gt;• Credentials and MFA codes never reach Travella services. &amp;nbsp; • All connections require HTTPS/TLS.&lt;br&gt;• Tokens, passwords, codes, and emails are redacted from logs. &amp;nbsp; • The API never trusts a browser-supplied user ID." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="980" width="850" height="86" as="geometry"/></mxCell>
        <mxCell id="37" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid arrow: request/action&lt;br&gt;Dashed arrow: response/outcome&lt;br&gt;Dashed vertical: participant lifeline" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="970" y="980" width="380" height="86" as="geometry"/></mxCell>
