        <mxCell id="20" value="US-001 · Login and authorized plan access" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="1270" height="26" as="geometry"/></mxCell>
        <mxCell id="2" value="Travella web app&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Custom registration &amp;amp; sign-in UI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="190" height="54" as="geometry"/></mxCell>
