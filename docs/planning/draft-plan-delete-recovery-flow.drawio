<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Codex" version="26.0.14">
  <diagram id="draft-plan-delete-recovery" name="Draft Plan delete and recovery">
    <mxGraphModel dx="1220" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Draft Plan soft-delete and recovery API flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1C1C1C;" vertex="1" parent="1"><mxGeometry x="45" y="40" width="620" height="32" as="geometry"/></mxCell>
        <mxCell id="active" value="Active Draft Plan&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;visible in GET /v1/plans?view=active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="215" height="74" as="geometry"/></mxCell>
        <mxCell id="confirm" value="Traveler confirms&lt;br&gt;Delete draft" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F2937;fontSize=14;" vertex="1" parent="1"><mxGeometry x="365" y="218" width="150" height="98" as="geometry"/></mxCell>
        <mxCell id="deleted" value="Recently deleted&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;hidden from active list; recovery deadline saved&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#B85450;fontColor=#1F2937;fontSize=15;" vertex="1" parent="1"><mxGeometry x="595" y="230" width="235" height="74" as="geometry"/></mxCell>
        <mxCell id="restore" value="POST /v1/plans/{planId}/restore&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;within seven-day recovery period&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E6;strokeColor=#82B366;fontColor=#1F2937;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="420" width="245" height="62" as="geometry"/></mxCell>
        <mxCell id="purge" value="Recovery deadline expires&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;purge identifiable Plan, Conversation, and checkpoint data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1F2937;fontSize=14;" vertex="1" parent="1"><mxGeometry x="940" y="230" width="255" height="74" as="geometry"/></mxCell>
        <mxCell id="error" value="Conflict / expired / foreign Plan&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;safe Problem response; no lifecycle change&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="420" width="200" height="62" as="geometry"/></mxCell>
        <mxCell id="deleteApi" value="DELETE /v1/plans/{planId}&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Idempotency-Key + expected revision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="355" y="120" width="170" height="58" as="geometry"/></mxCell>
        <mxCell id="e1" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="active" target="confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="1" source="confirm" target="deleteApi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="200 + recoveryDeadline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="1" source="deleteApi" target="deleted"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="deleted" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="latest consistent state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="restore" target="active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="after 7 days" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;" edge="1" parent="1" source="deleted" target="purge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="cancel / validation failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="confirm" target="error"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="The browser cannot supply an authoritative traveler ID. The CRUD backend derives ownership from the token and never reveals a foreign Plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="565" width="690" height="52" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
