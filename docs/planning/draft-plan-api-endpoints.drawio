<mxfile host="app.diagrams.net" modified="2026-09-13T00:00:00.000Z" agent="Codex" version="26.0.14">
  <diagram id="draft-plan-api-endpoints" name="Draft Plan API endpoints">
    <mxGraphModel dx="1220" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Travella — Draft Plan browser API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1C1C1C;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="540" height="32" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="All calls use the authenticated traveler from the access token. There is no past/completed Plan endpoint in this phase." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6270;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="820" height="24" as="geometry"/></mxCell>
        <mxCell id="browser" value="Browser frontend&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;My plans · open Plan · confirm delete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1F2937;fontSize=15;" vertex="1" parent="1"><mxGeometry x="55" y="250" width="180" height="76" as="geometry"/></mxCell>
        <mxCell id="crud" value="CRUD backend&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sole durable owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F2937;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="180" height="76" as="geometry"/></mxCell>
        <mxCell id="agent" value="Agent service&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AG-UI conversation only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1F2937;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="180" height="66" as="geometry"/></mxCell>
        <mxCell id="connector" value="Connector service&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;private provider capability checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#1F2937;fontSize=14;" vertex="1" parent="1"><mxGeometry x="970" y="520" width="180" height="66" as="geometry"/></mxCell>
        <mxCell id="active" value="GET /v1/plans?view=active&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;list active Draft Plans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A6C;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="355" y="112" width="245" height="52" as="geometry"/></mxCell>
        <mxCell id="deleted" value="GET /v1/plans?view=deleted&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Recently deleted + recovery deadline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A6C;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="645" y="112" width="255" height="52" as="geometry"/></mxCell>
        <mxCell id="create" value="POST /v1/plans&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;create empty Draft Plan + Conversation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A6C;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="355" y="190" width="245" height="52" as="geometry"/></mxCell>
        <mxCell id="open" value="GET /v1/plans/{planId}&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;open Plan + resume target&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0B7A6C;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="645" y="190" width="255" height="52" as="geometry"/></mxCell>
        <mxCell id="delete" value="DELETE /v1/plans/{planId}&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;soft-delete after traveler confirmation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#B85450;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="355" y="268" width="245" height="52" as="geometry"/></mxCell>
        <mxCell id="restore" value="POST /v1/plans/{planId}/restore&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;restore latest consistent Draft state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5E6;strokeColor=#82B366;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="645" y="268" width="255" height="52" as="geometry"/></mxCell>
        <mxCell id="session" value="AG-UI: open_plan_session / chat_message&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no durable Plan mutation without confirmation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="350" y="420" width="310" height="56" as="geometry"/></mxCell>
        <mxCell id="workspace" value="AG-UI: get_workspace_manifest&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;permanent map + need/capability-gated surfaces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C1C1C;fontSize=13;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="310" height="56" as="geometry"/></mxCell>
        <mxCell id="e1" value="active list" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B7A6C;fontSize=11;" edge="1" parent="1" source="browser" target="active"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="deleted list" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B7A6C;fontSize=11;" edge="1" parent="1" source="browser" target="deleted"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="new Plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B7A6C;fontSize=11;" edge="1" parent="1" source="browser" target="create"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="enter Plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0B7A6C;fontSize=11;" edge="1" parent="1" source="browser" target="open"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="confirmed delete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B85450;fontSize=11;" edge="1" parent="1" source="browser" target="delete"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="restore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="browser" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="authorized Plan reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="agent" target="crud"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="private capability check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="agent" target="connector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="conversation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=11;" edge="1" parent="1" source="browser" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="workspace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;fontSize=11;" edge="1" parent="1" source="browser" target="workspace"><mxGeometry relative="1" as="geometry"/></mxCell>
